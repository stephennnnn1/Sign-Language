<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Teachable Machine Live Classifier</title>
    <!-- Google Fonts & Tailwind CSS for modern styling -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col items-center justify-between p-4 sm:p-6">

    <!-- Header Section -->
    <header class="w-full max-w-4xl text-center py-6">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-white mb-2">AI Vision Classifier</h1>
        <p class="text-slate-400 text-sm sm:text-base">Real-time image classification powered by your Teachable Machine model.</p>
    </header>

    <!-- Main Content Grid -->
    <main class="w-full max-w-4xl grid grid-cols-1 md:grid-cols-2 gap-6 items-center bg-slate-800/50 border border-slate-700/60 rounded-2xl p-6 shadow-2xl backdrop-blur-sm">
        
        <!-- Left: Webcam Container -->
        <div class="flex flex-col items-center justify-center space-y-4">
            <div class="relative w-full aspect-square max-w-[360px] bg-slate-900 rounded-xl overflow-hidden border-2 border-slate-700 shadow-inner flex items-center justify-center">
                <!-- Loading State Indicator -->
                <div id="loading" class="absolute inset-flex flex-col items-center justify-center bg-slate-900/90 z-10 transition-opacity duration-300">
                    <svg class="animate-spin h-8 w-8 text-indigo-500 mb-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <span class="text-sm font-medium text-slate-300">Loading Model & Camera...</span>
                </div>
                <!-- Webcam DOM Node -->
                <div id="webcam-container" class="w-full h-full flex items-center justify-center"></div>
            </div>
            <button id="start-btn" onclick="init()" class="w-full max-w-[360px] bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 text-white font-medium py-3 px-4 rounded-xl shadow-lg transition-all duration-200 flex items-center justify-center space-x-2">
                <span>Restart / Reconnect Camera</span>
            </button>
        </div>

        <!-- Right: Live Predictions Output -->
        <div class="flex flex-col justify-center space-y-6">
            <div>
                <h2 class="text-xl font-semibold text-white mb-1">Live Predictions</h2>
                <p class="text-xs text-slate-400">Confidence levels update continuously in real time.</p>
            </div>
            
            <!-- Dynamic Label Container -->
            <div id="label-container" class="space-y-4">
                <!-- Prediction bars will be injected here dynamically -->
                <div class="text-slate-500 text-sm italic">Model is loading, please wait...</div>
            </div>
        </div>

    </main>

    <!-- Footer -->
    <footer class="w-full max-w-4xl text-center py-4 text-xs text-slate-500 border-t border-slate-800 mt-8">
        Built with Teachable Machine & TensorFlow.js
    </footer>

    <!-- TensorFlow.js and Teachable Machine Dependencies -->
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@latest/dist/tf.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@teachablemachine/image@latest/dist/teachablemachine-image.min.js"></script>

    <script>
        const URL = "https://teachablemachine.withgoogle.com/models/FYTKEpAnks/";

        let model, webcam, labelContainer, maxPredictions;
        let isInitialized = false;

        async function init() {
            if (isInitialized) {
                // If already initialized, restart webcam gracefully
                try {
                    if (webcam) await webcam.stop();
                } catch (e) {}
            }

            const loadingEl = document.getElementById("loading");
            loadingEl.style.opacity = "1";
            loadingEl.style.pointerEvents = "auto";

            try {
                const modelURL = URL + "model.json";
                const metadataURL = URL + "metadata.json";

                // Load the model and metadata if not already loaded
                if (!model) {
                    model = await tmImage.load(modelURL, metadataURL);
                    maxPredictions = model.getTotalClasses();
                }

                // Convenience function to setup a webcam
                const flip = true; // whether to flip the webcam
                webcam = new tmImage.Webcam(300, 300, flip); // width, height, flip
                await webcam.setup(); // request access to the webcam
                await webcam.play();
                window.requestAnimationFrame(loop);

                isInitialized = true;

                // Append elements to the DOM
                document.getElementById("webcam-container").innerHTML = "";
                document.getElementById("webcam-container").appendChild(webcam.canvas);

                // Initialize label container
                labelContainer = document.getElementById("label-container");
                labelContainer.innerHTML = "";
                for (let i = 0; i < maxPredictions; i++) {
                    // Create structured card for each class
                    const wrapper = document.createElement("div");
                    wrapper.className = "space-y-1";
                    
                    wrapper.innerHTML = `
                        <div class="flex justify-between text-sm">
                            <span id="class-name-${i}" class="font-medium text-slate-200">Class</span>
                            <span id="class-prob-${i}" class="font-semibold text-indigo-400">0%</span>
                        </div>
                        <div class="w-full bg-slate-900 rounded-full h-2.5 overflow-hidden border border-slate-700/50">
                            <div id="class-bar-${i}" class="bg-indigo-500 h-2.5 rounded-full transition-all duration-75" style="width: 0%"></div>
                        </div>
                    `;
                    labelContainer.appendChild(wrapper);
                }

                loadingEl.style.opacity = "0";
                loadingEl.style.pointerEvents = "none";

            } catch (error) {
                console.error("Initialization error:", error);
                document.getElementById("loading").innerHTML = `
                    <span class="text-rose-400 text-sm text-center px-4">Camera access denied or failed to load model. Please check permissions and refresh.</span>
                `;
            }
        }

        async function loop() {
            webcam.update(); // update the webcam frame
            await predict();
            window.requestAnimationFrame(loop);
        }

        async function predict() {
            // Predict can take in an image, video or canvas html element
            const prediction = await model.predict(webcam.canvas);
            for (let i = 0; i < maxPredictions; i++) {
                const className = prediction[i].className;
                const probability = (prediction[i].probability * 100).toFixed(1);

                // Update text values
                const nameEl = document.getElementById(`class-name-${i}`);
                const probEl = document.getElementById(`class-prob-${i}`);
                const barEl = document.getElementById(`class-bar-${i}`);

                if (nameEl && probEl && barEl) {
                    nameEl.innerText = className;
                    probEl.innerText = `${probability}%`;
                    barEl.style.width = `${probability}%`;
                }
            }
        }

        // Auto-initialize on page load
        window.addEventListener("DOMContentLoaded", () => {
            init();
        });
    </script>
</body>
</html>
